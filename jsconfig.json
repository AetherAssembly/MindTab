{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "noUnusedLocals": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "*.js",
    "content_scripts/**/*.js",
    "ui/**/*.js",
    "config/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "tests/**",
    "server/**",
    ".github/**"
  ]
}
