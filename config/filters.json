      "your pc is infected",
      "your device has a virus",
      "act now",
      "claim your prize",
      "claim your reward",
      "free gift card",
      "install now",
      "update required",
      "warning: your",
      "scan your computer",
      "you are the winner",
      "limited time offer",
      "you've been chosen"
    ],
    "hrefPatterns": [
      "download-now",
      "free-prize",
      "claim-reward",
      "virus-alert",
      "malware-scan",
      "win-prize",
      "free-gift-card"
    ]
  }
