{
    "name": "MindTab",
    "version": "1.0",
    "description": "Tone translation, and flash learning.",
    "manifest_version": 3,
    "permissions": ["storage"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches":["<all_urls>"],
            "js":["content_scripts/toneTranslator.js"],
            "css": ["content_scripts/toneTranslator.css"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/mindtab/mindtab16.svg",
        "32": "icons/mindtab/mindtab32.svg",
        "48": "icons/mindtab/mindtab48.svg",
        "128": "icons/mindtab/mindtab128.svg"
    },
    "action": {
     "default_icon": {
       "32": "icons/mindtab/mindtabA32.svg",
       "48": "icons/mindtab/mindtabA48.svg",
       "128": "icons/mindtab/mindtabA128.svg"
     }
    },
    "web_accessible_resources": [
        {
            "resources": [
                "content_scripts/toneTranslator.css",
                "icons/mindtab/*.svg",
                "icons/flashcard.svg",
                "icons/tone.svg",
                "flashcard/flashcard.js",
                "flashcard/flashcard.html",
                "flashcard/flashcard.css",
                "flashcard/config.json"
            ],
            "matches": ["<all_urls>"]
        }
    ]
}