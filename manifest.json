{
    "name": "MindTab",
    "version": "1.0",
    "description": "Visual tab memory, tone translation, and flash learning.",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/mindtab16.svg",
            "32": "icons/mindtab32.svg",
            "48": "icons/mindtab48.svg"
        }
    },
    "permissions": ["tabs","storage","sessions"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches":["<all_urls>"],
            "js":["content_scripts/toneTranslor.js"],
            "run_at": "document_idle"
        }
    ],
    "commands":{
        "restore_tab":{
            "suggested_key":{
                "default": "Ctrl+Shift+Z",
                "mac": "Command+Shift+Z"
            },
            "description": "Restore the last closed tab"
        }
    }
}